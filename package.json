{
  "name": "atracker",
  "productName": "ATracker",
  "version": "0.2.0",
  "private": true,
  "description": "本机 AI 编码 agent 的 token 用量看板",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwker/ATracker.git"
  },
  "homepage": "https://github.com/jwker/ATracker#readme",
  "bugs": {
    "url": "https://github.com/jwker/ATracker/issues"
  },
  "license": "MIT",
  "keywords": [
    "token",
    "usage",
    "dashboard",
    "codex",
    "claude-code",
    "opencode",
    "pi",
    "sqlite",
    "local-first"
  ],
  "author": "jwker",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "packages/desktop/src/main.ts",
  "scripts": {
    "scan": "node packages/cli/src/index.ts scan",
    "stats": "node packages/cli/src/index.ts stats",
    "dev:web": "vite packages/web",
    "build:web": "vite build packages/web",
    "serve": "npm run build:web && node packages/cli/src/index.ts serve",
    "serve:no-build": "node packages/cli/src/index.ts serve",
    "typecheck": "tsc --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "test": "node --test \"packages/**/*.test.ts\"",
    "desktop": "electron .",
    "dist:mac": "node scripts/dist.mjs --mac",
    "dist:win": "node scripts/dist.mjs --win",
    "icon": "electron packages/desktop/scripts/render-icon.mjs",
    "dist:mac:unsigned": "node scripts/dist.mjs --mac --unsigned",
    "pack:mac": "node scripts/dist.mjs --mac --dir --unsigned",
    "buildinfo": "node scripts/buildinfo.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
