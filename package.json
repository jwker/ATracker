{
  "name": "atracker",
  "productName": "ATracker",
  "version": "0.1.0",
  "private": true,
  "description": "本机 AI 编码 agent 的 token 用量看板",
  "author": "jwker",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "packages/desktop/src/main.ts",
  "scripts": {
    "scan": "node packages/cli/src/index.ts scan",
    "stats": "node packages/cli/src/index.ts stats",
    "dev:web": "vite packages/web",
    "build:web": "vite build packages/web",
    "serve": "npm run build:web && node packages/cli/src/index.ts serve",
    "serve:no-build": "node packages/cli/src/index.ts serve",
    "typecheck": "tsc --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "desktop": "electron .",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:win": "npm run build:web && electron-builder --win",
    "icon": "electron packages/desktop/scripts/render-icon.mjs",
    "dist:mac:unsigned": "npm run build:web && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "pack:mac": "npm run build:web && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
