{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    // "node" 只给 src 里的 *.test.ts 用（它们跑在 node --test 下，不是渲染进程）。
    // 页面代码不能用任何 Node API：渲染进程是沙箱，没有 process、fs 这些东西。
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
