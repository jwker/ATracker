{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/storage/**/*.ts",
    "packages/collectors/**/*.ts",
    "packages/server/**/*.ts",
    "packages/cli/**/*.ts",
    "packages/desktop/**/*.ts"
  ]
}
